# =============================================================================
# Git Ignore Configuration for Face2Health (Project Face)
# =============================================================================

# --- 1. Python, IDE, OS & Environment Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
venv/
.venv/
env/
.conda/
*.log

# --- 2. Model Weights & Heavy Checkpoints (Exceeding GitHub Limits) ---
*.pt
*.pth
*.ckpt
*.bin
*.onnx
archive/*.pt
archive/*.pth
weights/*.pt
weights/*.pth
# Ignore heavy pickle models but preserve json thresholds
weights/*.pkl
!weights/thresholds.json

# --- 3. Large Datasets & Raw Survey Files ---
# Image Repositories
data/Images/
data/test_images/

# SAS Transport Files & Heavy Processed CSVs
*.xpt
*.XPT
data/raw/
data/processed/nhanes_data_converted_WholeBody.csv
data/processed/nhanes_data_converted_DEMO_C.csv

# --- 4. Temporary Builds & Preview Images ---
scripts/results/page_*.png
scripts/results/_raw_*.pdf
reports/*_temp.pdf
reports/Paper_temp.pdf
reports/*สำรอง*
*.mp4

# --- 5. Scratch & Debug Scripts ---
scripts/checking.py
scripts/feature.py